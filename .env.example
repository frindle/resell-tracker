
# eGift runner for SCRAPE_EGIFT: builtin | shadow (default: built-in saves cards, then one plan dry run is compared) | plan
EGIFT_RUNNER=shadow

# Darkbloom purchases: a bloom-ledger API key (sent as a Bearer header). Needs BLOOM_LEDGER_URL too. Leave empty to keep pushes pending.
BLOOM_LEDGER_TOKEN=
