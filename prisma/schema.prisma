generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  orders        Order[]
  settings      Setting[]
  shippingRules ShippingRule[]
  creditCards   CreditCard[]
  senderRules   SenderRule[]
  bfmrWatchers  BfmrWatcher[]
  bgCommitments    BuyingGroupCommitment[]
  bfmrReservations BfmrReservation[]
  apiErrors        ApiError[]
  orderAttachments OrderAttachment[]
  createdAt        DateTime       @default(now())
}

model SenderRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  pattern   String   // substring match against sender email address
  createdAt DateTime @default(now())
}

model CreditCard {
  id            Int                @id @default(autoincrement())
  userId        Int?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  last4               String?  // last 4 digits — used for auto-assigning a card on order import when the scraped payment method matches
  milesProgram        String?  // e.g. "Chase UR", "Amex MR", "Delta SkyMiles"
  rewardsRate         Float?
  excludeShippingFromCashback Boolean @default(false) // e.g. Costco Executive's 2% rebate excludes shipping (and tax, which `cost` never includes)
  basePointsPerDollar Float?
  spendYearType       String  @default("calendar")  // "calendar" | "cardmember"
  spendYearResetMMDD  String?  // e.g. "03/15" — only used when spendYearType = "cardmember"
  merchantRates       CardMerchantRate[]
  orders        Order[]
  createdAt     DateTime           @default(now())
}

model CardMerchantRate {
  id              Int        @id @default(autoincrement())
  cardId          Int
  card            CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  merchant        String
  pointsPerDollar Float
  createdAt       DateTime   @default(now())

  @@unique([cardId, merchant])
}

model Buyer {
  id            Int            @id @default(autoincrement())
  name          String
  orders        Order[]
  shippingRules ShippingRule[]
  createdAt     DateTime       @default(now())
}

model BlockedAddress {
  id        Int      @id @default(autoincrement())
  label     String
  pattern   String
  createdAt DateTime @default(now())
}

model ShippingRule {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  label     String
  pattern   String
  buyerId   Int?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Setting {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model BgDealSnapshot {
  id          Int      @id @default(autoincrement())
  dealId      String
  title       String
  storeName   String
  retailPrice Float
  payoutPrice Float
  snapshotAt  DateTime @default(now())

  @@index([dealId])
}

model BgResolvedOrder {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique  // BG order_id e.g. "O-2521881381"
  createdAt DateTime @default(now())
}

model PortalRate {
  id         Int      @id @default(autoincrement())
  merchant   String   // e.g. "Walmart", "Best Buy" — matched against vendor_name from BFMR
  category   String   @default("")  // e.g. "Electronics" — empty string = applies to all
  portal     String   // e.g. "TopCashback", "Rakuten"
  rate       String   // e.g. "3%", "4.5%", "Excluded", "$5 flat"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchant, portal, category])
  @@index([merchant])
}

model BfmrWatcher {
  id          Int       @id @default(autoincrement())
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealSlug    String
  dealTitle   String?
  itemId      Int
  itemName    String?
  qty         Int
  active      Boolean   @default(true)
  lastChecked DateTime?
  lastResult  String?
  reservedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model ExtensionCommand {
  id            Int      @id @default(autoincrement())
  type          String   // SYNC_AMAZON | SYNC_WALMART | SYNC_COSTCO | SYNC_BIGSKY | SCRAPE_CBM
  payload       String?  // JSON
  status        String   @default("pending") // pending | running | done | failed
  result        String?
  targetBrowser String?  // 'firefox' | 'chrome' — when set, only that browser claims the command
  claimedBy     String?  // 'sidecar' | 'chrome' | 'firefox' -- whichever poller actually claimed
                          // this command, from its X-Extension-Browser header. Was previously
                          // read only for routing (targetBrowser filtering), never persisted --
                          // there was no way to tell whether a given sync actually ran via the
                          // sidecar or the browser extension after the fact.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BfmrSkip {
  id          Int      @id @default(autoincrement())
  orderNumber String   @unique
  createdAt   DateTime @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform        String
  orderNumber     String?
  orderDate       DateTime
  itemDescription String?
  cost            Float
  shippingCost    Float       @default(0)
  insuranceCost   Float       @default(0)
  salePrice         Float?
  salePriceSynced   Boolean     @default(false)
  buyerId         Int?
  buyer           Buyer?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  cardId          Int?
  card            CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cashbackAmount  Float       @default(0)
  portalCashback  Float?      // manually-entered pending/expected cashback from a shopping portal (TopCashback, Rakuten, etc.), separate from card cashbackAmount
  amexOfferDollars Float?     // Amex offer credit in dollars
  amexOfferPoints Int?       // Amex offer credit in points
  sourceUrl       String?
  shippingAddress String?
  trackingNumbers          String?   // comma-separated
  trackingValues           String?   // JSON: { [trackingNumber]: value }
  trackingSubmittedToBg    Boolean   @default(false)
  bgExpectedPayout         Float?
  bgPaidAmount             Float?
  notes            String?
  skipAddressBlock Boolean     @default(false)
  ignoredByRule    Boolean     @default(false)
  blockedAddressPattern String? // set on import when the address matched a BlockedAddress pattern; clears when user approves the order
  bgCredited       Boolean   @default(false)  // BG has a receipt in balance for this order
  buyerMismatch    Boolean   @default(false)  // paying group doesn't match assigned buyer
  groupReferenceId String?   // group-specific reference: BFMR order_id override, CardCenter payment ID, etc.
  bfmrReceived     Boolean     @default(false)
  bfmrStatus       String?   // last known BFMR status: received, processed, paid, etc.
  bfmrRejectedItems String?  // JSON array of {name, reason} for rejected items at processing
  // Cost basis of units removed from this order by partial returns. Kept
  // separate from `cost` so the original purchase amount is never destroyed:
  // `cost` stays what was actually paid, and P&L / "effective cost" use
  // (cost - returnedCost). Recomputed from OrderReturn rows, never hand-set.
  returnedCost     Float       @default(0)
  returns          OrderReturn[]
  overdueAt        DateTime?
  deliveryDeadline DateTime?   // hard deadline the group set for delivery; badge on order card
  lost             Boolean     @default(false)
  locked           Boolean     @default(false)
  cancelled        Boolean     @default(false)
  delayedShipping     Boolean   @default(false)  // Amazon "No-Rush" delivery — extra rewards in exchange for slower shipping
  noRushBonusPercent  Float?                     // captured from Amazon's "Earns extra N% on items using No-Rush delivery" disclosure
  attachments      OrderAttachment[]
  giftCards        GiftCard[]
  costcoReceipts   CostcoReceipt[]
  commitmentLinks  OrderCommitmentLink[]
  bfmrLinks        OrderBfmrLink[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  // Last interactive (form) edit. The optimistic-lock 409 compares against
  // this instead of updatedAt so background syncs — which bump updatedAt on
  // every order they touch — can't trigger false "modified by another
  // session" conflicts.
  userEditedAt     DateTime?

  @@index([userId, orderDate])
  @@index([userId, trackingSubmittedToBg])
}

// One row per active commitment fetched from BuyingGroup's
// /v1/commitment/get_commitments. Snapshot of what BG thinks we owe them.
// Synced via /api/buyinggroup/sync-commitments — upsert by commitmentId.
model BuyingGroupCommitment {
  id              Int      @id @default(autoincrement())
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  commitmentId    String   // BG's "CM-..." identifier
  dealId          String   // BG's "DL-..." identifier
  dealTitle       String
  itemId          String?
  itemImage       String?
  count           Int      // total committed quantity
  fulfilled       Int      // quantity BG has recorded as delivered
  expiryDay       DateTime?
  price           Float    // per-unit price
  commission      Float    @default(0)
  total           Float    // price × count
  bgPointsReward  Float    @default(0)
  status          String   // "ACTIVE", etc.
  raw             String?  // JSON of the full BG record for future fields
  createdDt       DateTime?
  lastSyncedAt    DateTime @default(now())

  orderLinks      OrderCommitmentLink[]

  @@unique([userId, commitmentId])
  @@index([dealId])
  @@index([userId, status])
}

// Many-to-many between Order and BuyingGroupCommitment. Lets the user
// assign N orders (or N units of an order) to a single commitment to
// satisfy the committed count. `quantity` is how many units of this order
// count toward the commitment.
model OrderCommitmentLink {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  commitmentId Int
  commitment   BuyingGroupCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([orderId, commitmentId])
  @@index([commitmentId])
}

// Snapshot of a BFMR tracker row. One row per reservation/shipment from
// BFMR's /my-tracker API. Synced via /api/bfmr/sync-reservations.
// Centralized log of non-2xx API responses across all the groups we
// integrate with (BG, BFMR, CC, Costco). Surfaced on /api-errors so
// the user can see failures across the board in one place.
model ApiError {
  id          Int       @id @default(autoincrement())
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  group       String    // 'BG' | 'BFMR' | 'CC' | 'Costco' | etc.
  endpoint    String    // path or URL
  method      String?   // 'GET' | 'POST' | 'PUT' etc.
  status      Int?      // HTTP status code (null for non-HTTP errors)
  body        String?   // response body (truncated to 2000 chars)
  orderId     Int?      // related local order, if known
  context     String?   // free-form: orderNumber, reservation id, sync run, etc.
  seen        Boolean   @default(false)  // flipped true when user opens /api-errors
  createdAt   DateTime  @default(now())

  @@index([userId, seen, createdAt])
  @@index([group, createdAt])
}

model BfmrReservation {
  id              Int       @id @default(autoincrement())
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  reserveId       String?
  // BFMR's internal reservation token (the "key" field in /my-tracker
  // responses). Persistent across cancel/recreate cycles — reserveId
  // changes when a reservation is cancelled and re-created, but internalKey
  // stays the same. Used to dedupe over-commit displays when BFMR churns.
  internalKey     String?
  purchaseId      String?
  shipmentId      String?
  bfmrOrderId     String?   // BFMR's order_id (retailer order number)
  trackingNumber  String?
  dealTitle       String?
  itemName        String?
  status          String
  qty             Int       @default(1)
  retailPrice     Float?
  totalPayout     Float?
  datePaid        DateTime?
  raw             String?
  lastSyncedAt    DateTime  @default(now())
  // Fields required by BFMR's /api/my-tracker POST when submitting tracking.
  // Captured from sync so we don't have to scrape them at submission time.
  // itemId/dealId are opaque encoded strings on BFMR's side (e.g.
  // "G8wLyggjI37dn7CPZdgTXA=="), NOT integers -- were wrongly typed Int?
  // here, so Number(item.deal_id) silently produced NaN and both fields
  // stayed null on every sync, no matter how many times it ran. Confirmed
  // live 2026-07-31 via the raw stored BFMR response.
  myTrackerId     Int?
  itemId          String?
  dealId          String?

  orderLinks         OrderBfmrLink[]
  submittedShipments BfmrSubmittedShipment[]

  @@unique([userId, reserveId])
  @@index([userId, status])
  @@index([bfmrOrderId])
  @@index([userId, internalKey])
}

// One row per successful tracking-number submission to BFMR for a
// reservation (the split-shipment review UI on the order detail page).
// Lets "remaining qty" be computed locally (reservation.qty minus the sum
// of these) without depending on scraping BFMR's own GET response shape,
// which isn't captured yet.
model BfmrSubmittedShipment {
  id             Int             @id @default(autoincrement())
  reservationId  Int
  reservation    BfmrReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  qty            Int
  trackingNumber String
  submittedAt    DateTime        @default(now())

  @@index([reservationId])
}

// Links an Order to a BfmrReservation, optionally scoped to a specific
// tracking number on the order. quantity = how many items from this
// reservation ship under this tracking. value = payout for those items.
model OrderBfmrLink {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservationId   Int
  reservation     BfmrReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  trackingNumber  String?
  quantity        Int      @default(1)
  value           Float?
  createdAt       DateTime @default(now())

  @@unique([orderId, reservationId, trackingNumber])
  @@index([reservationId])
}

// A quantity-aware return of SOME units of ONE line item on an order.
//
// This is the ONLY return system. It replaced a whole-order-only
// Order.returnStatus string, which could say "this order is being returned"
// but not "1 of the 3 units on this line went back" (the actual situation on
// order 832). One row here = N units of one line, with its own lifecycle. An
// order can have several, in different states, at the same time.
//
// The line is identified by whichever link table the order's items live in
// (BFMR reservation link / BG commitment link); `itemName` snapshots the label
// so the record survives the link being deleted or re-split, and unlinked
// orders (plain retail purchases with no group line at all) can still record
// a return with both link ids null.
//
// Shape deliberately mirrors what Amazon's own "return/refund status" page
// exposes — "Return requested for 1 of 3 items", "Return requested on: Aug 3,
// 2026" — so a scraped status string can be mapped onto `status` and the
// scraped date onto `requestedAt` without another schema change.
// See mapAmazonReturnStatus() in lib/orderReturns.ts (written, not yet wired).
model OrderReturn {
  id               Int      @id @default(autoincrement())
  orderId          Int
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Exactly one of these is set for a group-linked line; both null = the
  // order has no line items, so the return applies to the order as a whole.
  bfmrLinkId       Int?
  commitmentLinkId Int?
  itemName         String   // snapshot label of the line ("Deal title — item")
  trackingNumber   String?  // the OUTBOUND shipment these units went out on
  quantity         Int      @default(1)
  // requested   — return opened, item still with us
  // in_transit  — on its way back (to the retailer, or from the group to us
  //               for a rejected item)
  // received    — the retailer/we have it; refund not posted yet
  // refunded    — refund posted; refundAmount holds the actual money back
  // rejected    — the buying group refused the item and is shipping it back.
  //               NOT a completed sale, and no retailer refund exists yet.
  status           String   @default("requested")
  refundAmount     Float?   // actual money back from the retailer, once refunded
  requestedAt      DateTime? // when the return was opened (retailer's date, not ours)
  receivedAt       DateTime?
  refundedAt       DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([bfmrLinkId])
  @@index([commitmentLinkId])
}

model OrderAttachment {
  id           Int      @id @default(autoincrement())
  // Nullable: a bulk-uploaded photo lands here unassigned (orderId null)
  // until triaged onto a specific order. Directly-uploaded single
  // attachments (existing per-order upload form) always set orderId
  // immediately, same as before.
  orderId      Int?
  // SetNull, not Cascade: deleting an order shouldn't destroy a photo that
  // might just need reassigning to a different/corrected order -- it drops
  // back into the unassigned pool instead.
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Only meaningful while orderId is null -- scopes the unassigned pool to
  // the uploading account. Once assigned, the order's own userId is what
  // actually governs access; this is not re-checked afterward.
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  filename     String   // stored filename on disk
  originalName String   // original upload name
  mimeType     String
  // Clockwise display rotation in degrees (0/90/180/270) -- phone photos
  // often land sideways, and re-tilting your head every time to read a
  // gift card is what this fixes. Applied client-side via CSS transform
  // in the preview/zoom views, and server-side when generating thumbnails.
  rotation     Int      @default(0)
  createdAt    DateTime @default(now())
}

model CostcoReceipt {
  id                 Int      @id @default(autoincrement())
  transactionBarcode String   @unique
  transactionDate    String   // YYYY-MM-DD
  warehouseName      String
  total              Float
  receiptData        String   // full JSON from Costco API
  orderId            Int?
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
}

// CardCenter payment lifecycle: Waiting (scheduled, unpaid) → Sent → Completed.
// We store per-card so the rollup knows which listings are actually paid vs
// merely scheduled — a scheduled payment must not count toward bgPaidAmount.
model GiftCard {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant       String
  value          Float
  cardNumber     String
  pin            String?
  ccSubmittedAt   DateTime?
  ccGiftCardId    String?   // CC's gift card ID (e.g. 8232432) — card identity, stable across multiple sales/listings
  ccListingId     String?   // CC's listing ID (e.g. 9045043) — specific sale event; the payment is tied to a listing, not the card
  ccReservationId Int?
  ccSubmissionId  String?
  ccPurchasePrice Float?    // what CardCenter actually paid for this card (set at submission time)
  ccPaymentStatus String?   // 'Waiting' | 'Sent' | 'Completed' — payment lifecycle state from CC
  ccPaymentName   String?   // e.g. 'P1056-20260709' — the reference we're tracking
  ccPaymentDueAt  DateTime? // payment's receivedOn (scheduled/actual date). CC is manual about
                            // flipping Waiting→Sent, so a Waiting payment counts as paid once
                            // this date passes.
  // Provenance of cardNumber/pin — 'manual' | 'ocr_confirmed' | 'ocr_corrected'.
  // NULL on every row written before the gift-card OCR feature existed and on
  // every row written by the ordinary form, which is left untouched; read NULL
  // as "manual, unknown vintage". Recorded because a code a human typed unaided
  // and a code a human accepted from an OCR suggestion are not the same thing:
  // if an OCR-assisted code ever turns out wrong, this is what makes it
  // possible to find the others entered the same way instead of re-checking
  // everything. It also gives the real accepted-unchanged vs corrected rate,
  // which no 46-PIN benchmark can.
  codeSource       String?
  // How many preprocessing variants agreed on the suggestion at the moment it
  // was accepted. Null unless codeSource is one of the ocr_* values.
  codeOcrAgreement Int?
  createdAt       DateTime  @default(now())

  @@index([ccGiftCardId])
  @@index([ccListingId])
  @@index([orderId])
  @@index([orderId, ccPaymentStatus])
}

// One row per scrape/import call. Surfaces "what did the last sync touch?"
// on the sync-history page and behind clickable banner cards.
model SyncEvent {
  id          Int               @id @default(autoincrement())
  userId      Int?
  platform    String            // 'Amazon' | 'Walmart' | 'Costco' | etc.
  scraped     Int               @default(0)
  imported    Int               @default(0)
  updated     Int               @default(0)
  skipped     Int               @default(0)
  createdAt   DateTime          @default(now())
  orderChanges SyncEventOrder[]

  @@index([userId, createdAt])
}

// Per-order detail for a SyncEvent. `changedFields` holds a JSON object of
// { fieldName: [oldValue, newValue] } pairs for updates, or the initial
// values for creates (oldValue=null).
model SyncEventOrder {
  id            Int       @id @default(autoincrement())
  eventId       Int
  event         SyncEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderId       Int?      // null if order was later deleted
  orderNumber   String?   // snapshot for resilience if order is gone
  action        String    // 'created' | 'updated'
  changedFields String    // JSON: { field: [old, new] }

  @@index([eventId])
}

// Raw forensic trail of every outbound call this app makes to a third-party
// integration (BFMR, BuyingGroup, BigSky, CardCenter, ...) -- success AND
// failure, unlike ApiError above which only holds actionable failures for
// the user-facing /api-errors review queue. Built after a real 2026-08-21
// incident where reconstructing "did we actually submit twice, when, with
// what payload" from UI state alone wasn't possible. Rolling 7-day
// retention, pruned by startApiCallLogRetention() in instrumentation.ts.
model ApiCallLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  group        String   // 'BFMR' | 'BuyingGroup' | 'BigSky' | 'CardCenter' | etc.
  endpoint     String
  method       String
  status       Int?     // null if the request itself failed (network error, threw before a response)
  requestBody  String?  // truncated to 2000 chars
  responseBody String?  // truncated to 2000 chars
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([group, createdAt])
  @@index([createdAt])
}
